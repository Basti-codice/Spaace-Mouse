<Application x:Class="SpaceMouse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SpaceMouse.App.Services"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Light.xaml"/>
        <ResourceDictionary Source="Themes/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <svc:IconConverter x:Key="IconConv"/>
      <svc:BoolToVisibility x:Key="BoolVis"/>
      <svc:BoolToVisibility x:Key="BoolVisInv" Invert="True"/>
      <svc:NullToVisibility x:Key="NullVis"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
