<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SpaceMouseStudio</AssemblyName>
    <RootNamespace>SpaceMouse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Space Mouse Studio</Product>
    <Company>Space Mouse Studio</Company>
    <AssemblyTitle>Space Mouse Studio</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8618;CS0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpaceMouse.Core\SpaceMouse.Core.csproj" />
    <ProjectReference Include="..\SpaceMouse.Windows\SpaceMouse.Windows.csproj" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
