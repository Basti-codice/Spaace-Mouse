<Window x:Class="SpaceMouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Mouse Studio" Width="1240" Height="800" MinWidth="760" MinHeight="560"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavCol" Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Navigation ===== -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,18,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
          <Image Source="pack://application:,,,/Assets/app.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel x:Name="LogoText" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Space Mouse" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="Studio" Style="{StaticResource Muted}" Margin="0,-2,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="NavPanel"/>

        <Border x:Name="NavStatusBox" Grid.Row="2" Style="{StaticResource Inset}" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="NavDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="NavSource" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            </StackPanel>
            <TextBlock x:Name="NavDetail" Style="{StaticResource Muted}" FontSize="11" Margin="16,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===== Content ===== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="32,24,32,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,10" CornerRadius="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="SpaceMouse control" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
              <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11.5" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <CheckBox x:Name="ActiveSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnActiveClick"
                      ToolTip="Turn custom control on or off. Off = Standard mode, nothing is injected."/>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="Banner" Grid.Row="1" Margin="32,6,32,0" Style="{StaticResource Card}" Padding="16,10" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="BannerButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" Click="OnBannerClick"/>
        </Grid>
      </Border>

      <ContentControl x:Name="PageHost" Grid.Row="2" Margin="32,12,32,28"/>
    </Grid>
  </Grid>
</Window>
