<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#F4F5F8</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#F0F1F5</Color>
  <Color x:Key="SurfaceHoverColor">#E8EAF0</Color>
  <Color x:Key="BorderColor">#E1E4EB</Color>
  <Color x:Key="TextColor">#14161B</Color>
  <Color x:Key="MutedColor">#6A7180</Color>
  <Color x:Key="AccentColor">#5865F2</Color>
  <Color x:Key="AccentHoverColor">#4752D6</Color>
  <Color x:Key="AccentSoftColor">#E9EBFE</Color>
  <Color x:Key="OnAccentColor">#FFFFFF</Color>
  <Color x:Key="SuccessColor">#1FA971</Color>
  <Color x:Key="WarnColor">#D98A12</Color>
  <Color x:Key="DangerColor">#D6455B</Color>
  <Color x:Key="DeviceBodyColor">#DDE0EA</Color>
  <Color x:Key="DeviceCapColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DeviceBodyBrush" Color="{StaticResource DeviceBodyColor}"/>
  <SolidColorBrush x:Key="DeviceCapBrush" Color="{StaticResource DeviceCapColor}"/>
</ResourceDictionary>
