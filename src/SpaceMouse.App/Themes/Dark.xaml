<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#0E0F13</Color>
  <Color x:Key="SurfaceColor">#17191F</Color>
  <Color x:Key="SurfaceAltColor">#1D2028</Color>
  <Color x:Key="SurfaceHoverColor">#262A34</Color>
  <Color x:Key="BorderColor">#2A2E39</Color>
  <Color x:Key="TextColor">#ECEEF3</Color>
  <Color x:Key="MutedColor">#8B93A3</Color>
  <Color x:Key="AccentColor">#7B88FF</Color>
  <Color x:Key="AccentHoverColor">#95A0FF</Color>
  <Color x:Key="AccentSoftColor">#252A52</Color>
  <Color x:Key="OnAccentColor">#0E0F13</Color>
  <Color x:Key="SuccessColor">#3CCB92</Color>
  <Color x:Key="WarnColor">#F0A83A</Color>
  <Color x:Key="DangerColor">#F0647A</Color>
  <Color x:Key="DeviceBodyColor">#262A35</Color>
  <Color x:Key="DeviceCapColor">#3A3F4E</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DeviceBodyBrush" Color="{StaticResource DeviceBodyColor}"/>
  <SolidColorBrush x:Key="DeviceCapBrush" Color="{StaticResource DeviceCapColor}"/>
</ResourceDictionary>
