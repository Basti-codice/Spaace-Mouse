<UserControl x:Class="SpaceMouse.App.Pages.CustomizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SpaceMouse.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="440"/>
    </Grid.ColumnDefinitions>

    <!-- device + combinations -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Editing profile" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
            <ComboBox x:Name="ProfileBox" Grid.Column="1" DisplayMemberPath="Name" MaxWidth="280" HorizontalAlignment="Left" Width="260" SelectionChanged="OnProfileChanged"/>
            <TextBlock x:Name="PresetNote" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Padding="20,18">
          <c:SpaceMouseView x:Name="Device" MinHeight="380"/>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="Combinations" Style="{StaticResource H3}"/>
            <TextBlock Text="Hold a button and move the cap to trigger something different. Click one to edit it." Style="{StaticResource Muted}" Margin="0,2,0,10"/>
            <TextBlock x:Name="NoCombos" Text="No combinations yet. Select an axis and choose 'While Left held' to create one." Style="{StaticResource Muted}"/>
            <ItemsControl x:Name="ComboList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- editor -->
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Editor" Margin="22"/>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
