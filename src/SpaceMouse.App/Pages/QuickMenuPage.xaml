<UserControl x:Class="SpaceMouse.App.Pages.QuickMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SpaceMouse.App.Controls">
  <Grid>
    <!-- empty state -->
    <Border x:Name="EmptyState" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="520">
      <StackPanel>
        <TextBlock Text="No quick menu in this profile yet" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="A quick menu is a radial menu that appears around your cursor. Create one, fill it with actions and programs, then assign it to a button."/>
        <Button Content="Create quick menu" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnAddMenu"/>
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="MainGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" MinWidth="320"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer x:Name="QmLeft" Grid.Column="0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <Grid>
                <TextBlock Text="Menus" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="New menu" Click="OnAddMenu"/>
                  <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Duplicate menu" Click="OnDuplicateMenu"/>
                  <Button Content="&#xE70F;" Style="{StaticResource IconButton}" ToolTip="Rename menu" Click="OnRenameMenu"/>
                  <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete menu" Click="OnDeleteMenu"/>
                </StackPanel>
              </Grid>
              <TextBox x:Name="RenameBox" Margin="0,10,0,0" Visibility="Collapsed" KeyDown="OnRenameKey" LostFocus="OnRenameLost"/>
              <ListBox x:Name="MenuList" Style="{StaticResource PlainList}" Margin="0,8,0,0" SelectionChanged="OnMenuSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Padding="12,8" FontSize="13"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="PathText" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                <Button x:Name="UpButton" Content="&#xE72B;  Up one level" HorizontalAlignment="Right" Padding="10,5" Visibility="Collapsed" Click="OnUpLevel"/>
              </Grid>
              <c:RadialMenuControl x:Name="Preview" Width="340" Height="340" Margin="0,8,0,0"/>
              <Button Content="Try it" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnTry"/>
              <TextBlock x:Name="TryHint" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="QmRight" Grid.Column="2">
        <StackPanel x:Name="RightPanel">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <Grid>
                <TextBlock Text="Items" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="Add item" Click="OnAddItem"/>
                  <Button Content="&#xE70E;" Style="{StaticResource IconButton}" ToolTip="Move up" Click="OnMoveUp"/>
                  <Button Content="&#xE70D;" Style="{StaticResource IconButton}" ToolTip="Move down" Click="OnMoveDown"/>
                  <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove item" Click="OnRemoveItem"/>
                </StackPanel>
              </Grid>
              <ListBox x:Name="ItemList" Style="{StaticResource PlainList}" Margin="0,8,0,0" MaxHeight="230" SelectionChanged="OnItemSelected"/>
              <TextBlock x:Name="ItemsHint" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border x:Name="ItemEditor" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel x:Name="ItemEditorHost"/>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel x:Name="SettingsHost"/>
          </Border>

          <Border Style="{StaticResource Inset}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
              <TextBlock Text="How to open the menu" Style="{StaticResource H3}"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                         Text="On the Customize page, click a button of the SpaceMouse and choose 'Quick menu while held' (hold the button, point at an item, release to confirm) or 'Open quick menu' (press once; left button confirms, right button cancels). Every profile can have its own menus."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid></ScrollViewer>
  </Grid>
</UserControl>
