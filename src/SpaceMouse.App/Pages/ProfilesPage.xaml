<UserControl x:Class="SpaceMouse.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel>
      <Grid Margin="0,0,0,14">
        <TextBlock Text="Your profiles" Style="{StaticResource H2}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Import..." Click="OnImport"/>
          <Button Content="+ New profile" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnNew"/>
        </StackPanel>
      </Grid>
      <WrapPanel x:Name="CardsHost"/>

      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Switch profile automatically" Style="{StaticResource H2}"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                         Text="Optional. When one of the listed programs is in the foreground, its profile is activated. When none matches, your own choice is restored. Off by default."/>
            </StackPanel>
            <CheckBox x:Name="AutoSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0" Click="OnAutoSwitch"/>
          </Grid>
          <StackPanel x:Name="RulesHost" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
