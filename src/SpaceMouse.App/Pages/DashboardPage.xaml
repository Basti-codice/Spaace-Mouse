<UserControl x:Class="SpaceMouse.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SpaceMouse.App.Controls">
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="Root">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- ===== left: device + onboarding ===== -->
      <StackPanel x:Name="LeftCol" Grid.Column="0">
        <Border x:Name="Onboarding" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
          <StackPanel>
            <Grid>
              <TextBlock Text="Welcome - up and running in four steps" Style="{StaticResource H2}"/>
              <Button x:Name="DismissOnboarding" Content="Got it" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="OnDismissOnboarding"/>
            </Grid>
            <UniformGrid Columns="4" Margin="0,14,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Plug in the SpaceMouse" FontWeight="SemiBold" Margin="0,2,0,2" TextWrapping="Wrap"/>
                <TextBlock Text="No device? Try the virtual controller." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="2" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Calibrate once" FontWeight="SemiBold" Margin="0,2,0,2"/>
                <TextBlock Text="One minute, makes every axis correct." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Pick a profile" FontWeight="SemiBold" Margin="0,2,0,2"/>
                <TextBlock Text="Desktop, Browser, Productivity..." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="4" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Switch control on" FontWeight="SemiBold" Margin="0,2,0,2"/>
                <TextBlock Text="Top right. Off = nothing is touched." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Calibrate" Style="{StaticResource PrimaryButton}" Click="OnCalibrate"/>
              <Button Content="Open virtual controller" Margin="8,0,0,0" Click="OnVirtual"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,16,20,20">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="SourcePill" CornerRadius="12" Padding="10,4" Background="{DynamicResource SurfaceAltBrush}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SourceDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SourceBadge" FontSize="12" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="SourceTitle" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceDetail" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
              <Button Content="Virtual controller" HorizontalAlignment="Right" Click="OnVirtual" Padding="12,6" FontSize="12.5"/>
            </Grid>
            <c:SpaceMouseView x:Name="Device" Interactive="True" MinHeight="330"/>
            <TextBlock Text="Click any axis or button to change what it does." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ===== right: quick controls ===== -->
      <StackPanel x:Name="RightCol" Grid.Column="2">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Mode" Style="{StaticResource H3}"/>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="3" Margin="0,10,0,10">
              <UniformGrid Columns="2">
                <RadioButton x:Name="ModeStandard" Style="{StaticResource Segment}" Content="Standard" GroupName="mode" Click="OnModeClick"/>
                <RadioButton x:Name="ModeCustom" Style="{StaticResource Segment}" Content="Custom" GroupName="mode" Click="OnModeClick"/>
              </UniformGrid>
            </Border>
            <TextBlock x:Name="ModeText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="HotkeyText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Profile" Style="{StaticResource H3}"/>
            <ListBox x:Name="ProfileList" Style="{StaticResource PlainList}" Margin="0,8,0,0" SelectionChanged="OnProfileSelected" MaxHeight="260">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon, Converter={StaticResource IconConv}}" FontSize="17" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Recent activity" Style="{StaticResource H3}"/>
            </Grid>
            <TextBlock x:Name="NoActivity" Text="Actions you trigger show up here." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            <ItemsControl x:Name="ActivityList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="{Binding Text}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
